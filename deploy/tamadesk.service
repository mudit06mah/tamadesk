# tamadesk as a systemd *user* service: starts at login, restarts on failure.
# Install (from the repo folder):
#   sed -e "s#@REPO@#$PWD#" -e "s#@PATH@#$PATH#" deploy/tamadesk.service > ~/.config/systemd/user/tamadesk.service
#   systemctl --user enable --now tamadesk
# Logs: journalctl --user -u tamadesk -f
[Unit]
Description=tamadesk (desk companion: API + UI + reminders)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO@
# your shell's PATH at install time, so the service finds the same tools you do:
# claude (the brain), mcporter (agent-reach web search, often under nvm), notify-send (reminders)
Environment=PATH=@PATH@
ExecStart=%h/.local/bin/uv run --frozen tamadesk serve
Restart=on-failure
# uv exits 143 on a normal SIGTERM (logout/shutdown/restart); don't log that as a failure
SuccessExitStatus=143
RestartSec=5

[Install]
WantedBy=default.target
